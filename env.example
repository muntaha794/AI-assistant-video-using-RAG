# ── AI Meeting Assistant ─ environment template ──────────────────────────────
# Copy to .env and fill in. Every key has a sane default for local dev.

# General
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production (JSON lines for log aggregation)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite by default; use Postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./data/meetings.db
# DATABASE_URL=postgresql+asyncpg://meeting:meeting@localhost:5432/meetings
AUTO_CREATE_TABLES=true            # schema via Alembic in production (false there)

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=2880

# Uploads / file handling
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=314572800         # 300 MB

# LLM (Mistral free tier works: create a key at console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Speech-to-text / diarization
WHISPER_MODEL=base                 # tiny | base | small | medium | large-v3
DIARIZATION_ENABLED=true
HF_TOKEN=                          # HuggingFace read token with pyannote access (optional)

# RAG
VECTOR_STORE=chroma                # chroma | memory (memory is for tests)
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | hashing (no ML deps)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=6
RAG_MIN_SCORE=0.15

# Jobs
JOB_WORKERS=2
JOB_POLL_INTERVAL_SECONDS=2.0
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=30
